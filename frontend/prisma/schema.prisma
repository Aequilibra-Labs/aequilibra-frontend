// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExchangeEnum {
  EXTENDED
  HYPERLIQUID
  ASTER
  LIGHTER
  PARADEX
}

model User {
  id               Int               @id @default(autoincrement())
  wallet_key_public String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  investedData     InvestedData[]
  exchangeAccounts ExchangeAccount[]
}

model InvestedData {
  id             Int      @id @default(autoincrement())
  user_id        Int
  asset          String   @db.VarChar(30)
  invested_money Decimal  @db.Decimal(24, 10)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  user           User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model ExchangeAccount {
  id                       Int                @id @default(autoincrement())
  user_id                  Int
  exchange                 ExchangeEnum
  agent_key                String             @unique @db.VarChar(64)
  api_key_public           String?
  dek_encrypted            Bytes
  dek_iv                   Bytes
  dek_auth_tag             Bytes
  api_key_encrypted        Bytes?
  api_key_iv               Bytes?
  api_key_auth_tag         Bytes?
  api_secret_encrypted     Bytes?
  api_secret_iv            Bytes?
  api_secret_auth_tag      Bytes?
  api_passphrase_encrypted Bytes?
  api_passphrase_iv        Bytes?
  api_passphrase_auth_tag  Bytes?
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt
  user                     User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  extendedAccount          ExtendedAccount?
  hyperliquidAccount       HyperliquidAccount?
  asterAccount             AsterAccount?
  lighterAccount           LighterAccount?
  paradexAccount           ParadexAccount?

  @@index([user_id, exchange])
}

model ExtendedAccount {
  exchange_account_id Int            @id @unique
  exchangeAccount     ExchangeAccount @relation(fields: [exchange_account_id], references: [id], onDelete: Cascade)
}

model HyperliquidAccount {
  exchange_account_id Int            @id @unique
  exchangeAccount     ExchangeAccount @relation(fields: [exchange_account_id], references: [id], onDelete: Cascade)
}

model AsterAccount {
  exchange_account_id Int            @id @unique
  exchangeAccount     ExchangeAccount @relation(fields: [exchange_account_id], references: [id], onDelete: Cascade)
}

model LighterAccount {
  exchange_account_id Int            @id @unique
  exchangeAccount     ExchangeAccount @relation(fields: [exchange_account_id], references: [id], onDelete: Cascade)
}

model ParadexAccount {
  exchange_account_id Int            @id @unique
  exchangeAccount     ExchangeAccount @relation(fields: [exchange_account_id], references: [id], onDelete: Cascade)
}
